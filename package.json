{
  "name": "flow",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev:web": "pnpm --filter @flow/web dev",
    "build:web": "pnpm --filter @flow/web build",
    "lint:web": "pnpm --filter @flow/web lint",
    "lint:fsd:web": "pnpm --filter @flow/web lint:fsd",
    "typecheck:web": "pnpm --filter @flow/web typecheck",
    "dev:api": "pnpm --filter @flow/api dev",
    "build:api": "pnpm --filter @flow/api build",
    "typecheck:api": "pnpm --filter @flow/api typecheck",
    "prisma:generate": "pnpm --filter @flow/api prisma:generate",
    "prisma:migrate": "pnpm --filter @flow/api prisma:migrate",
    "db:seed": "pnpm --filter @flow/api db:seed",
    "db:reset": "pnpm --filter @flow/api db:reset"
  }
}
