# Flow web — environment variables
# Copy this file to `.env` and fill in the values. `.env` is never committed.
#
# IMPORTANT: any variable prefixed with NEXT_PUBLIC_ is inlined into the client
# bundle and visible to every user. Never put secrets behind that prefix.

# Public base URL of the web app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Flow API (apps/api). Server-side only: the browser never calls the
# API directly, Server Functions do it and forward the session.
API_URL=http://localhost:4000
