// Flow backend data model.
//
// Shapes mirror the TypeScript types the web frontend expects
// (apps/web/src/entities/*/model/types.ts). Instants are stored as DateTime and
// serialized as ISO strings (the frontend parses every one with `new Date()`).
// `Task.dueDate` stays a "YYYY-MM-DD" string because the frontend compares it
// with `===` against a calendar-day key.
//
// `position` columns preserve insertion order: the frontend renders lists
// (teams, board columns, sidebar tree) in the order the API returns them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
}

/// Role of a person in one space (see Membership). Guests (mentors) read and comment.
enum UserRole {
  leader
  member
  guest
}

enum TaskEventKind {
  status
  comment
}

enum TriageStatus {
  pending
  accepted
  declined
}

/// work: another team asks for something; join: a person asks to join the space.
enum TriageKind {
  work
  join
}

enum NotificationKind {
  mention
  assignment
  comment
  status
}

/// What happens to unfinished tasks when a cycle closes.
enum CycleRollover {
  next_cycle
  backlog
}

/// Team ids double as URL slugs and theme keys ("cs" | "pl" | "me" | "ii").
model Team {
  id           String  @id
  name         String
  abbreviation String
  mascotAlt    String
  position     Int     @default(autoincrement())
  /// Last number handed out for task identifiers (PL-56 -> next is PL-57).
  taskSeq      Int     @default(0)
  /// Weekly highlight shown on the space's home; leaders edit it.
  weeklyNote   String?

  users          User[]
  tasks          Task[]
  cycles         Cycle[]
  projects       Project[]
  documents      Document[]
  events         CalendarEvent[]
  activities     Activity[]
  triageOutgoing TriageRequest[] @relation("TriageFrom")
  triageIncoming TriageRequest[] @relation("TriageTo")
  invitations    Invitation[]
  memberships    Membership[]
  cycleSettings  CycleSettings?
}

model User {
  id           String    @id
  /// Sign-in identifier; stored lowercase.
  email        String    @unique
  /// scrypt hash (see src/auth/password.ts); null until the user sets a password.
  passwordHash String?
  name         String
  shortName    String
  initials     String
  /// Role in the home space (mirrors that space's Membership; kept for the web's current contract).
  role         UserRole
  /// Home space: where the user lands after signing in. Every space they belong to is in `memberships`.
  teamId       String
  /// Soft team tint for the avatar; null renders the neutral tone.
  avatarTone   String?
  position     Int       @default(autoincrement())
  /// Work area within the team ("Arte", "Programación", ...).
  area         String?
  /// Last authenticated request (refreshed at most once a minute). Drives "última actividad" and presence.
  lastActiveAt DateTime?
  /// File name of the uploaded profile photo (under UPLOADS_DIR/avatars).
  avatarPath   String?
  /// Set when the user finishes the onboarding, so it isn't shown again.
  onboardedAt  DateTime?

  team Team @relation(fields: [teamId], references: [id])

  memberships         Membership[]
  notifications       Notification[]  @relation("NotificationRecipient")
  notificationsCaused Notification[]  @relation("NotificationActor")
  eventAttendances    EventAttendee[]

  assignedTasks     Task[]            @relation("TaskAssignee")
  taskEvents        TaskEvent[]
  documentComments  DocumentComment[]
  authoredDocuments Document[]        @relation("DocumentUpdatedBy")
  activities        Activity[]
  triageRequests    TriageRequest[]   @relation("TriageRequester")
  triageDecisions   TriageRequest[]   @relation("TriageDecider")
  invitationsSent   Invitation[]

  @@index([teamId])
}

model TaskLabel {
  id       String  @id
  name     String
  /// Team palette the chip borrows; null renders the neutral tone.
  tone     String?
  position Int     @default(autoincrement())

  tasks Task[]
}

/// Team-scoped identifier: `${abbreviation}-${number}` (PL-42).
model Task {
  id               String        @id
  teamId           String
  title            String
  description      String?
  status           TaskStatus
  priority         TaskPriority?
  assigneeId       String?
  labelId          String?
  /// Calendar day "YYYY-MM-DD".
  dueDate          String?
  cycleId          String?
  projectId        String?
  milestoneId      String?
  /// Document the task was created from (checkbox -> task bridge).
  sourceDocumentId String?
  position         Int           @default(autoincrement())

  team           Team       @relation(fields: [teamId], references: [id])
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  label          TaskLabel? @relation(fields: [labelId], references: [id])
  cycle          Cycle?     @relation(fields: [cycleId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])
  sourceDocument Document?  @relation("TaskSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  events TaskEvent[]

  /// Tasks that block this one (this task is the blocked side).
  blockedBy TaskDependency[] @relation("Blocked")
  /// Tasks this one blocks (this task is the blocker side).
  blocks    TaskDependency[] @relation("Blocker")

  /// Documents whose content mentions this task's identifier (backlinks).
  mentions DocumentTaskMention[]

  notifications Notification[]
  triageLinks   TriageRequest[] @relation("TriageLinkedTask")

  @@index([teamId, position])
  @@index([cycleId])
}

/// Join table: `taskId` is blocked by `blockerId`.
model TaskDependency {
  taskId    String
  blockerId String

  task    Task @relation("Blocked", fields: [taskId], references: [id], onDelete: Cascade)
  blocker Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([taskId, blockerId])
  @@index([blockerId])
}

model TaskEvent {
  id       String        @id @default(cuid())
  taskId   String
  kind     TaskEventKind
  actorId  String
  /// Set when kind = status.
  status   TaskStatus?
  /// Set when kind = comment.
  body     String?
  at       DateTime
  /// Tiebreaker for entries with the same `at`.
  position Int           @default(autoincrement())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, at])
}

/// Two-week iteration; unfinished work rolls over to the next cycle.
model Cycle {
  id       String   @id
  teamId   String
  number   Int
  startsAt DateTime
  endsAt   DateTime

  team  Team   @relation(fields: [teamId], references: [id])
  tasks Task[]

  @@index([teamId, number])
}

model Project {
  id     String @id
  teamId String
  name   String

  team       Team          @relation(fields: [teamId], references: [id])
  milestones Milestone[]
  areas      ProjectArea[]
  tasks      Task[]

  @@index([teamId])
}

model Milestone {
  id        String   @id
  projectId String
  name      String
  date      DateTime
  position  Int      @default(autoincrement())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Progress per work area of the project, 0-100.
model ProjectArea {
  id        String @id @default(cuid())
  projectId String
  name      String
  progress  Int
  tone      String
  position  Int    @default(autoincrement())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Document {
  id          String   @id
  teamId      String
  title       String
  /// null for top-level pages of the space.
  parentId    String?
  updatedAt   DateTime
  updatedById String
  /// TipTap HTML content of the page.
  content     String   @default("<p></p>")
  position    Int      @default(autoincrement())

  // Notion-style page properties (all optional).
  propStatus  String?
  propOwnerId String?
  propTags    String[] @default([])

  /// Emoji (or short text) shown before the title.
  icon      String?
  /// Team palette key for the cover; null keeps the space's color.
  coverTone String?
  /// "BORRADOR" label: work in progress.
  isDraft   Boolean @default(false)

  team      Team       @relation(fields: [teamId], references: [id])
  updatedBy User       @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  /// Deleting a page deletes its whole subtree.
  parent    Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("DocumentTree")

  comments      DocumentComment[]
  sourcedTasks  Task[]                @relation("TaskSourceDocument")
  taskMentions  DocumentTaskMention[]
  notifications Notification[]

  @@index([teamId, position])
  @@index([teamId, updatedAt])
  @@index([parentId])
}

/// Join table: a document mentions a task (task backlinks).
model DocumentTaskMention {
  documentId String
  taskId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([documentId, taskId])
  @@index([taskId])
}

/// Margin comments. Threads are one level deep: a reply's parent is always a top-level comment.
model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  /// null for a thread's first comment.
  parentId   String?
  authorId   String
  body       String
  at         DateTime
  /// Tiebreaker for comments with the same `at`.
  position   Int      @default(autoincrement())

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [authorId], references: [id])
  parent   DocumentComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DocumentComment[] @relation("CommentThread")

  @@index([documentId, at])
  @@index([parentId])
}

model CalendarEvent {
  id       String    @id @default(cuid())
  teamId   String
  title    String
  startsAt DateTime
  /// null for a single all-day event; set for timed or multi-day events.
  endsAt   DateTime?
  /// Explicit all-day flag (multi-day events like a 2-day hackathon also have `endsAt`).
  allDay   Boolean   @default(false)
  /// Dot color in event lists.
  tone     String

  team      Team            @relation(fields: [teamId], references: [id])
  attendees EventAttendee[]

  @@index([teamId, startsAt])
  @@index([startsAt])
}

/// Who attends an event (any team): lets the calendar warn about clashes.
model EventAttendee {
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model Activity {
  id       String   @id @default(cuid())
  teamId   String
  actorId  String
  /// What the actor did, rendered after their name.
  summary  String
  at       DateTime
  /// Tiebreaker for entries with the same `at`.
  position Int      @default(autoincrement())

  team  Team @relation(fields: [teamId], references: [id])
  actor User @relation(fields: [actorId], references: [id])

  @@index([teamId, at])
}

/// A request from another team (or a new member) waiting for a leader's decision.
model TriageRequest {
  id           String       @id @default(cuid())
  fromTeamId   String
  toTeamId     String
  title        String
  requesterId  String?
  createdAt    DateTime
  status       TriageStatus @default(pending)
  decidedAt    DateTime?
  decidedById  String?
  /// Task created in the receiving team when the request was accepted.
  taskId       String?
  kind         TriageKind   @default(work)
  /// Details for the receiving team.
  description  String?
  /// Desired date, calendar day "YYYY-MM-DD"; becomes the task's due date.
  dueDate      String?
  /// Requester's task that waits on this request: once accepted, it's blocked by the new task.
  linkedTaskId String?

  fromTeam   Team  @relation("TriageFrom", fields: [fromTeamId], references: [id])
  toTeam     Team  @relation("TriageTo", fields: [toTeamId], references: [id])
  requester  User? @relation("TriageRequester", fields: [requesterId], references: [id])
  decidedBy  User? @relation("TriageDecider", fields: [decidedById], references: [id])
  linkedTask Task? @relation("TriageLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([toTeamId, status, createdAt])
}

/// One-time invitation to join a team; the invitee sets their password with the link.
model Invitation {
  id          String    @id @default(cuid())
  /// SHA-256 of the link's token (the token itself is shown once and never stored).
  tokenHash   String    @unique
  /// Stored lowercase.
  email       String
  name        String
  role        UserRole
  teamId      String
  invitedById String
  createdAt   DateTime
  expiresAt   DateTime
  acceptedAt  DateTime?

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedById], references: [id])

  @@index([teamId])
  @@index([email])
}

/// A person's place in a space. People can belong to several spaces with a different role in each.
model Membership {
  userId   String
  teamId   String
  role     UserRole
  joinedAt DateTime @default(now())
  position Int      @default(autoincrement())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId, position])
}

/// Personal inbox entry (mentions, assignments, comments, status changes).
model Notification {
  id         String           @id @default(cuid())
  /// Recipient.
  userId     String
  /// Who caused it (null if that account was removed).
  actorId    String?
  kind       NotificationKind
  /// Ready-to-show line ("Ana te asignó PL-42").
  title      String
  /// Snippet of the comment or text, when there is one.
  excerpt    String?
  taskId     String?
  documentId String?
  createdAt  DateTime
  readAt     DateTime?
  /// Tiebreaker for entries with the same `createdAt`.
  position   Int              @default(autoincrement())

  user     User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// How a space runs its cycles (leaders edit it in Ajustes / Ciclos).
model CycleSettings {
  teamId      String        @id
  enabled     Boolean       @default(true)
  /// 1 to 3 weeks.
  lengthWeeks Int           @default(2)
  /// Day cycles start on: 0 = domingo, 1 = lunes, ..., 6 = sabado.
  startDay    Int           @default(1)
  rollover    CycleRollover @default(next_cycle)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
