// Flow backend data model.
//
// Shapes mirror the TypeScript types the web frontend expects
// (apps/web/src/entities/*/model/types.ts). Instants are stored as DateTime and
// serialized as ISO strings (the frontend parses every one with `new Date()`).
// `Task.dueDate` stays a "YYYY-MM-DD" string because the frontend compares it
// with `===` against a calendar-day key.
//
// `position` columns preserve insertion order: the frontend renders lists
// (teams, board columns, sidebar tree) in the order the API returns them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum UserRole {
  leader
  member
}

enum TaskEventKind {
  status
  comment
}

/// Team ids double as URL slugs and theme keys ("cs" | "pl" | "me" | "ii").
model Team {
  id           String @id
  name         String
  abbreviation String
  mascotAlt    String
  position     Int    @default(autoincrement())
  /// Last number handed out for task identifiers (PL-56 -> next is PL-57).
  taskSeq      Int    @default(0)

  users          User[]
  tasks          Task[]
  cycles         Cycle[]
  projects       Project[]
  documents      Document[]
  events         CalendarEvent[]
  activities     Activity[]
  triageOutgoing TriageRequest[] @relation("TriageFrom")
  triageIncoming TriageRequest[] @relation("TriageTo")
}

model User {
  id           String   @id
  /// Sign-in identifier; stored lowercase.
  email        String   @unique
  /// scrypt hash (see src/auth/password.ts); null until the user sets a password.
  passwordHash String?
  name         String
  shortName    String
  initials     String
  role         UserRole
  teamId       String
  /// Soft team tint for the avatar; null renders the neutral tone.
  avatarTone String?
  position   Int      @default(autoincrement())

  team Team @relation(fields: [teamId], references: [id])

  assignedTasks     Task[]            @relation("TaskAssignee")
  taskEvents        TaskEvent[]
  documentComments  DocumentComment[]
  authoredDocuments Document[]        @relation("DocumentUpdatedBy")
  activities        Activity[]
  triageRequests    TriageRequest[]

  @@index([teamId])
}

model TaskLabel {
  id       String  @id
  name     String
  /// Team palette the chip borrows; null renders the neutral tone.
  tone     String?
  position Int     @default(autoincrement())

  tasks Task[]
}

/// Team-scoped identifier: `${abbreviation}-${number}` (PL-42).
model Task {
  id               String        @id
  teamId           String
  title            String
  description      String?
  status           TaskStatus
  priority         TaskPriority?
  assigneeId       String?
  labelId          String?
  /// Calendar day "YYYY-MM-DD".
  dueDate          String?
  cycleId          String?
  projectId        String?
  milestoneId      String?
  /// Document the task was created from (checkbox -> task bridge).
  sourceDocumentId String?
  position         Int           @default(autoincrement())

  team           Team       @relation(fields: [teamId], references: [id])
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  label          TaskLabel? @relation(fields: [labelId], references: [id])
  cycle          Cycle?     @relation(fields: [cycleId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])
  sourceDocument Document?  @relation("TaskSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  events TaskEvent[]

  /// Tasks that block this one (this task is the blocked side).
  blockedBy TaskDependency[] @relation("Blocked")
  /// Tasks this one blocks (this task is the blocker side).
  blocks    TaskDependency[] @relation("Blocker")

  /// Documents whose content mentions this task's identifier (backlinks).
  mentions DocumentTaskMention[]

  @@index([teamId, position])
  @@index([cycleId])
}

/// Join table: `taskId` is blocked by `blockerId`.
model TaskDependency {
  taskId    String
  blockerId String

  task    Task @relation("Blocked", fields: [taskId], references: [id], onDelete: Cascade)
  blocker Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([taskId, blockerId])
  @@index([blockerId])
}

model TaskEvent {
  id      String        @id @default(cuid())
  taskId  String
  kind    TaskEventKind
  actorId String
  /// Set when kind = status.
  status  TaskStatus?
  /// Set when kind = comment.
  body    String?
  at      DateTime

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, at])
}

/// Two-week iteration; unfinished work rolls over to the next cycle.
model Cycle {
  id       String   @id
  teamId   String
  number   Int
  startsAt DateTime
  endsAt   DateTime

  team  Team   @relation(fields: [teamId], references: [id])
  tasks Task[]

  @@index([teamId, number])
}

model Project {
  id     String @id
  teamId String
  name   String

  team       Team          @relation(fields: [teamId], references: [id])
  milestones Milestone[]
  areas      ProjectArea[]
  tasks      Task[]

  @@index([teamId])
}

model Milestone {
  id        String   @id
  projectId String
  name      String
  date      DateTime
  position  Int      @default(autoincrement())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Progress per work area of the project, 0-100.
model ProjectArea {
  id        String @id @default(cuid())
  projectId String
  name      String
  progress  Int
  tone      String
  position  Int    @default(autoincrement())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Document {
  id          String   @id
  teamId      String
  title       String
  /// null for top-level pages of the space.
  parentId    String?
  updatedAt   DateTime
  updatedById String
  /// TipTap HTML content of the page.
  content     String   @default("<p></p>")
  position    Int      @default(autoincrement())

  // Notion-style page properties (all optional).
  propStatus  String?
  propOwnerId String?
  propTags    String[] @default([])

  team      Team       @relation(fields: [teamId], references: [id])
  updatedBy User       @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  /// Deleting a page deletes its whole subtree.
  parent    Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("DocumentTree")

  comments     DocumentComment[]
  sourcedTasks Task[]                @relation("TaskSourceDocument")
  taskMentions DocumentTaskMention[]

  @@index([teamId, position])
  @@index([teamId, updatedAt])
  @@index([parentId])
}

/// Join table: a document mentions a task (task backlinks).
model DocumentTaskMention {
  documentId String
  taskId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([documentId, taskId])
  @@index([taskId])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  body       String
  at         DateTime

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([documentId, at])
}

model CalendarEvent {
  id       String    @id
  teamId   String
  title    String
  startsAt DateTime
  /// null for all-day events.
  endsAt   DateTime?
  /// Dot color in event lists.
  tone     String

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, startsAt])
}

model Activity {
  id      String   @id
  teamId  String
  actorId String
  /// What the actor did, rendered after their name.
  summary String
  at      DateTime

  team  Team @relation(fields: [teamId], references: [id])
  actor User @relation(fields: [actorId], references: [id])

  @@index([teamId, at])
}

/// A request from another team (or a new member) waiting for a leader's decision.
model TriageRequest {
  id          String   @id
  fromTeamId  String
  toTeamId    String
  title       String
  requesterId String?
  createdAt   DateTime

  fromTeam  Team  @relation("TriageFrom", fields: [fromTeamId], references: [id])
  toTeam    Team  @relation("TriageTo", fields: [toTeamId], references: [id])
  requester User? @relation(fields: [requesterId], references: [id])

  @@index([toTeamId, createdAt])
}
