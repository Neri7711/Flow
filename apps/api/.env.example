# PostgreSQL connection string used by Prisma.
# Matches the service defined in docker-compose.yml.
DATABASE_URL="postgresql://flow:flow@localhost:5432/flow?schema=public"

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed by CORS (the web app in dev).
WEB_ORIGIN="http://localhost:3000"

# Secret used to sign session tokens (JWT). Use a long random value in production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET="dev-only-change-me"

# How long a session lasts before signing in again.
JWT_EXPIRES_IN="7d"

# Password given to every seeded user (moge@flow.test, ana@flow.test, ...). Development only.
SEED_PASSWORD="flow-dev-password"

# Folder for uploaded files (profile photos). Development storage: in production use a
# persistent volume here or move to object storage.
UPLOADS_DIR="uploads"
